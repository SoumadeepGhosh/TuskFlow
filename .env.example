# ============================================================
# TaskFlow — Environment Variables Reference
# ============================================================
# Copy this file to backend/.env and fill in your own values.
# NEVER commit real secrets to this file or to git.
# ============================================================

# ----- App -----
APP_NAME=TaskFlow
PORT=3000
NODE_ENV=development
API_PREFIX=api
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ----- Database (PostgreSQL) -----
# Local Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"
# Production (Neon / Railway / Supabase):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# ----- JWT -----
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_CHARACTER_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ----- Redis -----
# Local Docker:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Production (Railway Redis plugin injects these automatically):
# REDIS_URL=redis://default:PASSWORD@HOST:PORT
# REDIS_PRIVATE_URL=redis://default:PASSWORD@PRIVATE_HOST:PORT

# ----- Cloudflare R2 Storage -----
# Create a bucket in https://dash.cloudflare.com/ > R2 > Create bucket
# Then create an API token with Object Read & Write permissions
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Optional: set this if your R2 bucket has a public domain
# R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ----- Brevo Transactional Email REST API (v3) -----
# 1. Go to https://app.brevo.com/
# 2. SMTP & API > API Keys tab (NOT SMTP Keys tab)
# 3. Click "Generate a new API key" — key starts with "xkeysib-"
BREVO_API_KEY=YOUR_BREVO_V3_API_KEY_STARTING_WITH_xkeysib
# Must be a verified sender in your Brevo account
MAIL_FROM="TaskFlow <notifications@yourdomain.com>"

